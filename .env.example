# Credentials for the OpenAI-compatible endpoint that serves the model.
OPENAI_API_KEY=
# Set this only when the model is reached through another endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# INFONIUM_MODEL=gpt-6.1-terra
# The model that translates a document unless the reader chooses another under 翻译模型.
# INFONIUM_TRANSLATION_MODEL=gpt-6-luna
# The API the endpoint speaks: chat_completions or responses.
# INFONIUM_WIRE_API=chat_completions
# INFONIUM_LANGUAGE=简体中文

# GLM's models, which the reader may also choose for a translation, are reached at GLM's
# endpoint with GLM's own key. The default endpoint is that of GLM's Coding Plan.
# INFONIUM_GLM_API_KEY=
# INFONIUM_GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# INFONIUM_GLM_MODELS=["glm-5.3", "glm-5.3-flash"]
# INFONIUM_DATA_DIR=data
# The MinerU command that parses PDFs, when it is not on the PATH.
# INFONIUM_PDF_ENGINE=mineru
# The Chrome command that renders a web page whose HTML holds little text, when it is not on
# the PATH.
# INFONIUM_BROWSER=google-chrome

# The recogniser that turns speech into text, reached through OpenAI's transcription API.
# The default is the local one of engines/speech. Another endpoint needs its own key.
# INFONIUM_SPEECH_BASE_URL=http://127.0.0.1:8750/v1
# INFONIUM_SPEECH_API_KEY=unused
# INFONIUM_SPEECH_MODEL=Systran/faster-whisper-large-v3

# The engine that turns the library's blocks into vectors, so that they are found by meaning,
# reached through OpenAI's embeddings API. The default is the local one of engines/embedding.
# Without it, blocks are found by their words alone.
# INFONIUM_EMBEDDING_BASE_URL=http://127.0.0.1:8751/v1
# INFONIUM_EMBEDDING_API_KEY=unused
# INFONIUM_EMBEDDING_MODEL=ibm-granite/granite-embedding-97m-multilingual-r2
