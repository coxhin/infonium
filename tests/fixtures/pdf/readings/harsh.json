  },
  {
   "kind": "paragraph",
   "text": "For Kovac the argument is beside the point.",
   "marks": [],
   "places": [
    {
     "kind": "page",
     "start": 0,
     "end": 43,
     "page": 5,
     "left": 0.531,
     "top": 0.599,
     "width": 0.403,
     "height": 0.020000000000000018
    }
   ]
  },
  {
   "kind": "paragraph",
   "text": "\"People are not buying a bed. They are buying the hours in between.\"",
   "marks": [],
   "places": [
    {
     "kind": "page",
     "start": 0,
