     "height": 0.024000000000000132
    }
   ]
  },
  {
   "kind": "paragraph",
   "text": "She woke at dawn on the Venice causeway, the lagoon grey and still outside her window, and understood why she had come back.",
   "marks": [],
   "places": [
    {
