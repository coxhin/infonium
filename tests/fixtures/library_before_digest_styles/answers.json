          "sections": [
            {
              "title": "摘要",
              "statements": [
                {
                  "text": "Quillmoor 的港口账簿记下了冬季每个工作日夜渡的发船时间。",
                  "anchors": [
                    {
                      "document_id": "5f5acbeaf10fb9e046f6ac35843a9a0dd67244c0b097c3577760b79adffad27c",
                      "block_number": 1,
                      "start": 45,
                      "end": 88,
                      "quote": "the night ferry left at a quarter past nine"
                    }
                  ],
                  "lost_citations": 0
                },
                {
                  "text": "守账人 Odalys Brenn 用绿墨记发船，用红墨记延误。",
                  "anchors": [
                    {
                      "document_id": "5f5acbeaf10fb9e046f6ac35843a9a0dd67244c0b097c3577760b79adffad27c",
                      "block_number": 2,
                      "start": 26,
                      "end": 81,
                      "quote": "wrote each departure in green ink and each delay in red"
                    }
                  ],
                  "lost_citations": 0
                }
              ]
            },
            {
              "title": "要点",
              "statements": [
                {
                  "text": "第三个冬季渡船有四十一个夜晚晚点，多在东防波堤起雾的几周。",
                  "anchors": [
                    {
                      "document_id": "5f5acbeaf10fb9e046f6ac35843a9a0dd67244c0b097c3577760b79adffad27c",
                      "block_number": 3,
                      "start": 20,
                      "end": 58,
                      "quote": "the ferry ran late on forty-one nights"
                    },
                    {
                      "document_id": "5f5acbeaf10fb9e046f6ac35843a9a0dd67244c0b097c3577760b79adffad27c",
                      "block_number": 3,
                      "start": 86,
                      "end": 126,
                      "quote": "when fog lay over the eastern breakwater"
                    }
                  ],
                  "lost_citations": 0
                },
                {
                  "text": "镇议会把发船提前到八点半，次年冬季晚点降到九次。",
                  "anchors": [
                    {
                      "document_id": "5f5acbeaf10fb9e046f6ac35843a9a0dd67244c0b097c3577760b79adffad27c",
                      "block_number": 4,
                      "start": 76,
                      "end": 106,
                      "quote": "cut the late crossings to nine"
                    }
                  ],
                  "lost_citations": 1
                },
                {
                  "text": "账簿至今保存在镇图书馆。",
                  "anchors": [
                    {
                      "document_id": "5f5acbeaf10fb9e046f6ac35843a9a0dd67244c0b097c3577760b79adffad27c",
                      "block_number": 5,
                      "start": 10,
                      "end": 30,
                      "quote": "港の帳簿は町の図書館に今も保管されている"
                    }
                  ],
                  "lost_citations": 0
                }
              ]
            }
          ]
        }
      ]
    },
